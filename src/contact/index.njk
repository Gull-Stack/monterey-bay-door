                    <div style="position:absolute;left:-9999px;opacity:0;height:0;width:0" aria-hidden="true"><input type="text" name="fax_number" tabindex="-1" autocomplete="off" aria-label="Leave this field empty"></div>
                    <input type="hidden" name="_timestamp" id="_timestamp" value="">

                    <fieldset style="margin-bottom: 1.5rem;">
                        <legend>What do you need? *</legend>
                        <label class="choice">
                            <input type="radio" name="request-type" value="bid" required>
                            <span><strong>A project quote</strong><br><span style="font-size: 0.95rem; color: #555;">You have plans, specs or a door schedule and want a price.</span></span>
                        </label>
                        <label class="choice">
                            <input type="radio" name="request-type" value="service" required>
                            <span><strong>A service call</strong><br><span style="font-size: 0.95rem; color: #555;">Something is broken or needs repair, and you want someone out soon.</span></span>
                        </label>
                    </fieldset>

                    <p class="group-title" style="margin-top: 0;">Your contact information</p>
                    <div class="row2">
                        <div class="f">
                            <label for="name">Your name *</label>
                            <input type="text" id="name" name="name" required autocomplete="name">
                        </div>
                        <div class="f">
                            <label for="company">Company / organization</label>
                            <input type="text" id="company" name="company" autocomplete="organization">
                        </div>
                    </div>
                    <div class="row2">
                        <div class="f">
                            <label for="email">Email *</label>
                            <input type="email" id="email" name="email" required autocomplete="email">
                        </div>
                        <div class="f">
                            <label for="phone">Callback phone<span id="phone-star" hidden> *</span></label>
                            <input type="tel" id="phone" name="phone" autocomplete="tel">
                        </div>
                    </div>

                    <!-- Project quote fields -->
                    <fieldset id="bid-fields" hidden disabled>
                        <p class="group-title">About your project</p>
                        <div class="row2">
                            <div class="f">
                                <label for="project-name">Project name *</label>
                                <input type="text" id="project-name" name="project-name" required maxlength="120">
                            </div>
                            <div class="f">
                                <label for="project-city">Project city / ZIP *</label>
                                <input type="text" id="project-city" name="project-city" required maxlength="80">
                            </div>
                        </div>
                        <div class="row2">
                            <div class="f">
                                <label for="bid-scope">What do you need? *</label>
                                <select id="bid-scope" name="bid-scope" required>
                                    <option value="">Choose your scope</option>
                                    <option value="complete-opening">Complete opening package</option>
                                    <option value="doors-frames">Doors &amp; frames</option>
                                    <option value="hardware">Hardware</option>
                                    <option value="access-control">Access control</option>
                                    <option value="trim-millwork">Trim &amp; millwork</option>
                                    <option value="project-documents">Project documents</option>
                                    <option value="not-sure">Not sure yet</option>
                                </select>
                            </div>
                            <div class="f">
                                <label for="supply-install">Supply / installation *</label>
                                <select id="supply-install" name="supply-install" required>
                                    <option value="">Choose an option</option>
                                    <option value="supply-only">Supply only</option>
                                    <option value="supply-install">Supply and installation</option>
                                    <option value="not-sure">Not sure yet</option>
                                    <option value="documents-only">Documents only</option>
                                </select>
                            </div>
                        </div>
                        <div class="row2">
                            <div class="f">
                                <label for="bid-due">Bid due date</label>
                                <input type="date" id="bid-due" name="bid-due">
                            </div>
                            <div class="f">
                                <label for="plan-link">Plan link, if available</label>
                                <input type="url" id="plan-link" name="plan-link" placeholder="https://" maxlength="500" inputmode="url">
                            </div>
                        </div>
                    </fieldset>

                    <!-- Service call fields -->
                    <fieldset id="service-fields" hidden disabled>
                        <p class="group-title">Where is the problem?</p>
                        <div class="row2">
                            <div class="f">
                                <label for="property-name">Property / business name</label>
                                <input type="text" id="property-name" name="property-name" maxlength="120">
                            </div>
                            <div class="f">
                                <label for="door-location">Door mark / opening location</label>
                                <input type="text" id="door-location" name="door-location" placeholder="For example: rear exit, door 104" maxlength="120">
                            </div>
                        </div>
                        <div class="f">
                            <label for="service-address">Full service address *</label>
                            <input type="text" id="service-address" name="service-address" required autocomplete="street-address" maxlength="200">
                        </div>
                        <div class="row2">
                            <div class="f">
                                <label for="service-issue">Issue *</label>
                                <select id="service-issue" name="service-issue" required>
                                    <option value="">Choose the closest description</option>
                                    <option value="wont-close">Door will not close or latch</option>
                                    <option value="closer-operator">Closer or automatic operator problem</option>
                                    <option value="lock-exit-device">Lock or exit-device problem</option>
                                    <option value="damaged">Damaged door, frame, or hinges</option>
                                    <option value="access-control">Access-control problem</option>
                                    <option value="other">Something else</option>
                                </select>
                            </div>
                            <div class="f">
                                <label for="service-urgency">How soon is attention needed? *</label>
                                <select id="service-urgency" name="service-urgency" required>
                                    <option value="">Choose an option</option>
                                    <option value="routine">Routine / planning ahead</option>
                                    <option value="soon">Needs attention soon</option>
                                    <option value="urgent">Urgent, please contact me</option>
                                </select>
                            </div>
                        </div>
                    </fieldset>

                    <div class="f">
                        <label for="message" id="message-label">Project details</label>
                        <textarea id="message" name="message" rows="5" maxlength="4000" placeholder="Tell us about your project."></textarea>
                    </div>

                    <fieldset id="service-extras" hidden disabled>
                        <details>
                            <summary>Different on-site contact? Add their details.</summary>
                            <div class="row2">
                                <div class="f">
                                    <label for="onsite-name">On-site contact name</label>
                                    <input type="text" id="onsite-name" name="onsite-name" maxlength="120">
                                </div>
                                <div class="f">
                                    <label for="onsite-phone">On-site contact phone</label>
                                    <input type="tel" id="onsite-phone" name="onsite-phone" maxlength="40">
                                </div>
                            </div>
                        </details>
                        <div class="f">
                            <div class="drop">
                                <label for="photos" style="margin: 0;"><strong>Add photos of the opening or hardware</strong></label>
                                <p class="hint" id="photos-hint" style="margin: 0 0 0.75rem;">Optional. Up to 5 photos.</p>
                                <input type="file" id="photos" accept="image/*" multiple aria-describedby="photos-hint photos-status">
                                <div class="thumbs" id="thumbs"></div>
                                <p class="hint" id="photos-status" role="status"></p>
                            </div>
                        </div>
                    </fieldset>

                    <button type="submit" class="btn btn-primary" style="width: 100%;">Send Request</button>
                    <div id="form-status" role="status" style="margin-top:12px;text-align:center;font-weight:500;"></div>
                </form>
                <script>
                (function () {
                  var form = document.getElementById('contact-form');
                  var status = document.getElementById('form-status');
                  var groups = {
                    bid: [document.getElementById('bid-fields')],
                    service: [document.getElementById('service-fields'), document.getElementById('service-extras')]
                  };
                  var message = document.getElementById('message');
                  var messageLabel = document.getElementById('message-label');
                  var phone = document.getElementById('phone');
                  var phoneStar = document.getElementById('phone-star');
                  var MAX_PHOTOS = 5;
                  var photos = []; // data URLs, already shrunk
                  document.getElementById('_timestamp').value = Date.now();
                  // Nobody asks for a bid due date in the past.
                  document.getElementById('bid-due').min = new Date().toISOString().slice(0, 10);

                  function setType(type) {
                    Object.keys(groups).forEach(function (key) {
                      groups[key].forEach(function (el) {
                        el.hidden = key !== type;
                        el.disabled = key !== type;
                      });
                    });
                    var service = type === 'service';
                    message.required = service;
                    phone.required = service;
                    phoneStar.hidden = !service;
                    messageLabel.textContent = service ? 'Describe what is happening *' : 'Anything else we should know?';
                    message.placeholder = service
                      ? 'What is the door or hardware doing? When did you notice it?'
                      : 'Opening quantities, schedule requirements, or questions about the scope';
                  }
                  form.querySelectorAll('input[name="request-type"]').forEach(function (radio) {
                    radio.addEventListener('change', function () { setType(radio.value); });
                    if (radio.checked) setType(radio.value);
                  });

                  // Photos are shrunk in the browser so five phone photos fit in one request.
                  var photoInput = document.getElementById('photos');
                  var photoStatus = document.getElementById('photos-status');
                  var thumbs = document.getElementById('thumbs');

                  function shrink(file, edge, quality) {
                    return new Promise(function (resolve, reject) {
                      var url = URL.createObjectURL(file);
                      var img = new Image();
                      img.onload = function () {
                        var scale = Math.min(1, edge / Math.max(img.naturalWidth, img.naturalHeight));
                        var canvas = document.createElement('canvas');
                        canvas.width = Math.max(1, Math.round(img.naturalWidth * scale));
                        canvas.height = Math.max(1, Math.round(img.naturalHeight * scale));
                        canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
                        URL.revokeObjectURL(url);
                        resolve(canvas.toDataURL('image/jpeg', quality));
                      };
                      img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('unreadable')); };
                      img.src = url;
                    });
                  }

                  function drawThumbs() {
                    thumbs.innerHTML = '';
                    photos.forEach(function (src, i) {
                      var wrap = document.createElement('div');
                      wrap.className = 'thumb';
                      var img = document.createElement('img');
                      img.src = src;
                      img.alt = 'Photo ' + (i + 1);
                      var btn = document.createElement('button');
                      btn.type = 'button';
                      btn.textContent = '×';
                      btn.setAttribute('aria-label', 'Remove photo ' + (i + 1));
                      btn.addEventListener('click', function () {
                        photos.splice(i, 1);
                        drawThumbs();
                        photoStatus.textContent = photos.length ? photos.length + ' of ' + MAX_PHOTOS + ' photos added.' : '';
                      });
                      wrap.appendChild(img);
                      wrap.appendChild(btn);
                      thumbs.appendChild(wrap);
                    });
                  }

                  photoInput.addEventListener('change', async function () {
                    var files = Array.prototype.slice.call(photoInput.files || []);
                    photoInput.value = '';
                    var skipped = 0;
                    for (var i = 0; i < files.length; i++) {
                      if (photos.length >= MAX_PHOTOS) { skipped += files.length - i; break; }
                      try {
                        var data = await shrink(files[i], 1400, 0.75);
                        if (data.length > 900000) data = await shrink(files[i], 1000, 0.7);
                        if (data.indexOf('data:image/jpeg;base64,') !== 0 || data.length > 900000) throw new Error('too big');
                        photos.push(data);
                      } catch (e) { skipped++; }
                    }
                    drawThumbs();
                    photoStatus.textContent = photos.length + ' of ' + MAX_PHOTOS + ' photos added.' +
                      (skipped ? ' ' + skipped + ' could not be added. You can email them to service@mbdoor.com.' : '');
                  });

                  form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var btn = form.querySelector('[type="submit"]');
                    var originalText = btn.textContent;
                    btn.textContent = 'Sending...';
                    btn.disabled = true;
                    status.textContent = '';
                    try {
                      // Disabled (hidden) groups are left out of FormData by the browser.
                      var data = Object.fromEntries(new FormData(form));
                      if (data['request-type'] === 'service' && photos.length) data.photos = photos;
                      var res = await fetch('/api/contact', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                      });
                      if (!res.ok) throw new Error();
                      status.innerHTML = '<span style="color:#15803d">Request sent. We\'ll be in touch within one business day.</span>';
                      form.reset();
                      photos = [];
                      drawThumbs();
                      photoStatus.textContent = '';
                      setType('');
                      document.getElementById('_timestamp').value = Date.now();
                    } catch (err) {
                      status.innerHTML = '<span style="color:#b91c1c">We could not send your request. Please call (831) 757-1878.</span>';
                    } finally {
                      btn.textContent = originalText;
                      btn.disabled = false;
                    }
                  });
                })();
                </script>
            </div>
            
            <!-- Contact Information -->
            <div>
