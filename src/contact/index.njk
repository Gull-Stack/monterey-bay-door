                <style>
                .mbd-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
                .mbd-form .f { margin-bottom: 1.25rem; }
                .mbd-form label, .mbd-form legend { display: block; margin-bottom: 0.5rem; font-weight: 500; }
                .mbd-form input[type="text"], .mbd-form input[type="email"], .mbd-form input[type="tel"],
                .mbd-form input[type="url"], .mbd-form input[type="date"], .mbd-form select, .mbd-form textarea {
                    width: 100%; padding: 0.9rem 1rem; border: 1px solid #b9b9b0; border-radius: var(--border-radius);
                    font: inherit; font-size: 1rem; background: #fff; color: var(--color-text-dark); box-sizing: border-box;
                }
                .mbd-form textarea { resize: vertical; }
                .mbd-form :is(input, select, textarea):focus-visible { outline: 3px solid var(--color-accent); outline-offset: 1px; }
                .mbd-form .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
                .mbd-form fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
                .mbd-form .group-title { font-size: 1.15rem; font-weight: 700; color: var(--color-primary-dark); margin: 1.75rem 0 1rem; }
                .mbd-form .choice { display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.9rem 1rem; border: 1px solid #b9b9b0; border-radius: var(--border-radius); margin-bottom: 0.5rem; cursor: pointer; font-weight: 400; }
                .mbd-form .choice:has(input:checked) { border-color: var(--color-accent); background: #eef1e6; }
                .mbd-form .choice input { margin-top: 0.25rem; }
                .mbd-form .hint { font-size: 0.9rem; color: #555; margin: 0.35rem 0 0; }
                .mbd-form .drop { border: 1px dashed #8d9a78; border-radius: var(--border-radius); background: #eef1e6; padding: 1.25rem; text-align: center; }
                .mbd-form .drop strong { display: block; margin-bottom: 0.25rem; }
                .mbd-form .thumbs { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.75rem; justify-content: center; }
                .mbd-form .thumb { position: relative; }
                .mbd-form .thumb img { width: 84px; height: 84px; object-fit: cover; border-radius: 0.5rem; display: block; }
                .mbd-form .thumb button { position: absolute; top: -8px; right: -8px; width: 28px; height: 28px; border-radius: 50%; border: 0; background: var(--color-primary-dark); color: #fff; font-size: 1rem; line-height: 1; cursor: pointer; }
                .mbd-form details { margin-bottom: 1.25rem; }
                .mbd-form summary { cursor: pointer; color: var(--color-accent); text-decoration: underline; margin-bottom: 0.75rem; }
                .mbd-form [hidden] { display: none !important; }
                @media (max-width: 860px) { .mbd-two-col { grid-template-columns: 1fr; gap: 2.5rem; } }
                @media (max-width: 560px) { .mbd-form .row2 { grid-template-columns: 1fr; gap: 0; } }
                </style>

                <form class="mbd-form" style="margin-top: 2rem;" action="/api/contact" method="POST" id="contact-form">
